{
  "name": "threejs-journey-exercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup:lab": "node -e \"const fs=require('fs');const src='teoria-sintergica/brain-prototype/frontend/public/models/brain';const dest='static/models/brain';if(!fs.existsSync(dest)&&fs.existsSync(src)){fs.mkdirSync('static/models',{recursive:true});fs.cpSync(src,dest,{recursive:true});console.log('✅ Brain model copied')}else{console.log('ℹ️ Already exists or source not found')}\"",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "vaca:format": "prettier --check src/vaca-futbolera",
    "vaca:lint": "eslint src/vaca-futbolera",
    "vaca:types": "tsc --noEmit",
    "vaca:test": "vitest run --coverage",
    "vaca:gauntlet": "npm run vaca:format && npm run vaca:lint && npm run vaca:types && npm run vaca:test"
  },
  "devDependencies": {
